# The repo holds scripts and reports only. Every collected window, cache, ledger, log and fork build stays local.

# secrets
infura_keys.txt
etherscan_key.txt
getblock_keys.json
*_keys.txt
*_keys.json

# environment / OS
.venv/
__pycache__/
*.pyc
.DS_Store

# research/: ignore everything, then re-admit reports (markdown, figures) and the code written for a study
# (python, our own Solidity tests/contracts, foundry configs). Directories must be re-admitted for the file rules to reach.
research/**
!research/**/
!research/**/*.md
!research/**/*.py
!research/**/*.sol
!research/**/*.svg
!research/**/*.png
!research/**/foundry.toml
!research/**/remappings.txt
!research/**/strategy_book.txt

# ...except third-party code pulled in for a study: verified contract sources and forge deps/builds
research/**/sources/
research/**/raw/docs/
research/**/lib/
research/**/out/
research/**/cache/

# scripts/: generated caches and audit outputs (curated registries such as address_labels.json stay tracked)
scripts/selector_cache.json
scripts/labels_audit.json
*.log
*.err
*.stdout

# research markdown that is not a report: runner logs, regenerated table and detector dumps, LLM labeling packets
research/**/*_log.md
research/**/*tables.md
research/**/detectors.md
research/**/packets.md
research/**/label_batches/
